<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Session 1 / 1000"
            android:textColor="#FFFF8A9A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="✓ done"
            android:textColor="#FF7EE2A0"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 5"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_jp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="おはよう ございます"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/w_romaji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="o-ha-yō go-zai-mas"
            android:textColor="#FFFF8A9A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Good morning (polite)"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_prev"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@drawable/w_btn_bg"
            android:text="◀"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/w_listen"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/w_btn_bg"
            android:text="🔊 Listen"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/w_next"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_btn_bg"
            android:text="▶"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/w_start"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_start_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/w_start"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="#FFC8283C"
        android:progressBackgroundTint="#33FFFFFF" />

    <TextView
        android:id="@+id/w_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 / 1000 sessions"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
